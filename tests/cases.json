  {
    "name": "cache hit verified",
    "request": {
      "tasks": [
        {
          "id": "a",
          "command": [
            "echo",
            "a"
          ],
          "inputs": [
            "in.txt"
          ],
          "outputs": [
            "a.txt"
          ]
        }
      ],
      "hashes": {
        "in.txt": "h",
        "a.txt": "ha"
      },
      "cache": {
        "a": {
          "fingerprint": {
            "version": 1,
            "command": [
              "echo",
              "a"
            ],
            "inputs": {
              "in.txt": "h"
            },
            "outputs": [
              "a.txt"
            ],
            "environment": {},
            "dependencies": {}
          },
          "outputs": {
            "a.txt": "ha"
          }
        }
      }
    },
    "expected": {
      "tasks/0/status": "cached",
      "tasks/0/reason": "fingerprint and outputs verified",
      "terminal": true,
      "success": true,
      "cache/a/outputs/a.txt": "ha"
    },
    "error": false,
    "note": "A cache entry is reused only when the fingerprint matches and every declared output still has the recorded digest."
  },
