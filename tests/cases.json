  {
    "name": "initial ready wave",
    "request": {
      "tasks": [
        {
          "id": "a",
          "command": [
            "echo",
            "a"
          ],
          "inputs": [
            "in.txt"
          ],
          "outputs": [
            "a.txt"
          ]
        },
        {
          "id": "b",
          "command": [
            "echo",
            "b"
          ],
          "deps": [
            "a"
          ],
          "inputs": [
            "a.txt"
          ],
          "outputs": [
            "b.txt"
          ]
        }
      ],
      "hashes": {
        "in.txt": "h"
      }
    },
    "expected": {
      "ready/0/id": "a",
      "tasks/0/reason": "no cache entry",
      "tasks/1/status": "waiting",
      "tasks/1/reason": "waiting for: a",
      "terminal": false,
      "summary/ready": [
        "a"
      ],
      "summary/waiting": [
        "b"
      ]
    },
    "error": false,
    "note": "Tasks are reported in execution order. The first wave contains every task whose dependencies are satisfied, up to the concurrency bound; each task carries the reason for its status."
  },
