  {
    "name": "deterministic order by id",
    "request": {
      "tasks": [
        {
          "id": "b",
          "command": [
            "x"
          ]
        },
        {
          "id": "10",
          "command": [
            "x"
          ]
        },
        {
          "id": "a",
          "command": [
            "x"
          ]
        },
        {
          "id": "9",
          "command": [
            "x"
          ]
        }
      ]
    },
    "expected": {
      "tasks/0/id": "10",
      "tasks/1/id": "9",
      "tasks/2/id": "a",
      "tasks/3/id": "b"
    },
    "error": false,
    "note": "Independent tasks are ordered by id in UTF-16 code unit order, so plans are reproducible."
