        },
        {
          "id": "b",
          "command": [
            "echo",
            "b"
          ],
          "deps": [
            "a"
          ],
          "inputs": [
            "a.txt"
          ],
          "outputs": [
            "b.txt"
          ]
        },
        {
          "id": "c",
          "command": [
            "echo",
            "c"
          ],
          "deps": [
            "b"
          ],
          "inputs": [
            "b.txt"
          ],
          "outputs": [
            "c.txt"
          ]
        }
      ],
      "hashes": {
        "in.txt": "h2",
        "a.txt": "ha",
        "b.txt": "hb",
        "c.txt": "hc"
      },
      "cache": {
        "a": {
          "fingerprint": {
            "version": 1,
            "command": [
              "echo",
              "a"
            ],
            "inputs": {
              "in.txt": "h"
            },
            "outputs": [
              "a.txt"
            ],
            "environment": {},
            "dependencies": {}
          },
          "outputs": {
            "a.txt": "ha"
          }
        }
      }
    },
    "expected": {
      "tasks/0/status": "ready",
      "tasks/0/reason": "fingerprint changed: inputs",
      "tasks/1/status": "waiting",
      "tasks/1/reason": "waiting for: a",
      "tasks/2/reason": "waiting for: b",
      "terminal": false
    },
    "error": false,
    "note": "Dependents cannot be judged until the changed producer has run again; their fingerprints include the producer's new fingerprint."
  },
